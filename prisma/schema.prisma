// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int          @id @default(autoincrement())
  nama              String
  username          String       @unique
  password          String       // Hash bcrypt
  role              String       // "karyawan" | "admin" | "super_admin"
  aktif             Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  transaksiKasir    Transaksi[]  @relation("KasirUserRelation")
  transaksiKaryawan Transaksi[]  @relation("KaryawanUserRelation")
  promosCreated     Promo[]
  auditLogs         AuditLog[]
  shifts            ShiftKasir[]
}

model SystemSetting {
  id          Int      @id @default(1)
  namaToko    String   @default("Kasir Coffee Shop")
  alamatToko  String   @default("Jl. Kopi No. 123, Jakarta")
  teleponToko String   @default("0812-3456-7890")
  persenPajak Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // e.g. "VOID_TRANSACTION", "DELETE_MENU", "CREATE_PROMO"
  details   String   @db.Text
  createdAt DateTime @default(now())
}

model Kategori {
  id        Int      @id @default(autoincrement())
  nama      String   @unique
  menus     Menu[]
  promos    Promo[]  @relation("KategoriPromoRelation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Menu {
  id              Int               @id @default(autoincrement())
  nama            String
  harga           Int
  kategoriId      Int
  kategori        Kategori          @relation(fields: [kategoriId], references: [id], onDelete: Cascade)
  gambar          String?           @db.Text
  tersedia        Boolean           @default(true)
  detailTransaksi DetailTransaksi[]
  promoMenus      PromoMenu[]
  resepMenus      ResepMenu[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model ShiftKasir {
  id                  Int       @id @default(autoincrement())
  kasirId             Int
  kasir               User      @relation(fields: [kasirId], references: [id], onDelete: Cascade)
  namaKasir           String
  waktuBuka           DateTime  @default(now())
  waktuTutup          DateTime?
  modalAwal           Int       @default(0) // Cash drawer float
  totalTunaiSistem    Int       @default(0)
  totalQrisSistem     Int       @default(0)
  totalFreeOrderSistem Int      @default(0)
  hitungFisikTunai    Int?
  selisihKas          Int?
  catatan             String?   @db.Text
  status              String    @default("OPEN") // "OPEN" | "CLOSED"
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model BahanBaku {
  id          Int         @id @default(autoincrement())
  nama        String
  satuan      String      // "gram", "ml", "pcs", "pack"
  stok        Float       @default(0)
  stokMinim   Float       @default(10)
  hargaSatuan Int         @default(0)
  resepMenus  ResepMenu[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model ResepMenu {
  id          Int       @id @default(autoincrement())
  menuId      Int
  menu        Menu      @relation(fields: [menuId], references: [id], onDelete: Cascade)
  bahanBakuId Int
  bahanBaku   BahanBaku @relation(fields: [bahanBakuId], references: [id], onDelete: Cascade)
  jumlahPakai Float     // e.g. 18 (gram), 150 (ml)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([menuId, bahanBakuId])
}

model Transaksi {
  id               Int               @id @default(autoincrement())
  nomorStruk       String            @unique @default(uuid())
  tanggal          DateTime          @default(now())
  jenisTransaksi   String            @default("regular") // "regular" | "karyawan"
  karyawanId       Int?
  karyawan         User?             @relation("KaryawanUserRelation", fields: [karyawanId], references: [id], onDelete: SetNull)
  namaKaryawan     String?
  kasirId          Int?
  kasir            User?             @relation("KasirUserRelation", fields: [kasirId], references: [id], onDelete: SetNull)
  namaKasir        String            @default("Kasir Cafe")
  metodePembayaran String            @default("TUNAI")
  subtotal         Int
  totalHargaAsli   Int               @default(0) // Total nilai asli sebelum diskon
  totalDiskon      Int               @default(0) // Total hemat promo
  pajak            Int               @default(0)
  totalHarga       Int
  dibayar          Int
  kembalian        Int
  isVoid           Boolean           @default(false)
  voidReason       String?
  voidBy           String?
  detailTransaksi  DetailTransaksi[]
  createdAt        DateTime          @default(now())
}

model Promo {
  id              Int               @id @default(autoincrement())
  nama            String
  tipeDiskon      String            // "persentase" | "nominal" | "harga_tetap"
  nilai           Float
  tanggalMulai    DateTime?         // Untuk promo tanggal khusus
  tanggalSelesai  DateTime?
  jamMulai        String?           // Format "HH:mm", untuk promo jam recurring
  jamSelesai      String?
  berlakuUntuk    String            // "semua" | "kategori" | "menu_tertentu"
  kategoriId      Int?
  kategori        Kategori?         @relation("KategoriPromoRelation", fields: [kategoriId], references: [id], onDelete: SetNull)
  aktif           Boolean           @default(true)
  createdBy       Int
  creator         User              @relation(fields: [createdBy], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  promoMenus      PromoMenu[]
  detailTransaksi DetailTransaksi[]
}

model PromoMenu {
  id      Int   @id @default(autoincrement())
  promoId Int
  promo   Promo @relation(fields: [promoId], references: [id], onDelete: Cascade)
  menuId  Int
  menu    Menu  @relation(fields: [menuId], references: [id], onDelete: Cascade)
}

model DetailTransaksi {
  id          Int        @id @default(autoincrement())
  transaksiId Int
  transaksi   Transaksi  @relation(fields: [transaksiId], references: [id], onDelete: Cascade)
  menuId      Int?
  menu        Menu?      @relation(fields: [menuId], references: [id], onDelete: SetNull)
  namaMenu    String
  hargaSatuan Int        // Harga final setelah promo
  hargaAsli   Int        @default(0) // Harga normal menu
  hargaPromo  Int?       // Harga promo per unit jika ada promo
  promoId     Int?
  promo       Promo?     @relation(fields: [promoId], references: [id], onDelete: SetNull)
  namaPromo   String?
  jumlah      Int
  subtotal    Int
}
